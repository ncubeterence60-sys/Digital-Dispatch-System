{
  "name": "admin-app",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc --skipLibCheck && vite build && copy dashboard.html dist",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "leaflet": "^1.9.4",
    "postcss": "^8.4.47",
    "react-leaflet": "^4.2.1",
    "tailwindcss": "^3.4.13",
    "typescript": "5.3",
    "vite": "^8.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.digitaldispatch.admin",
    "productName": "Digital Dispatch Admin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "dashboard.html"
    ]
  }
}
